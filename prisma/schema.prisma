generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ManualPriceLock {
  id        String   @id
  uid       String
  goodsId   String
  variantId String?
  until     DateTime
  createdAt DateTime @default(now())

  @@unique([uid, goodsId])
  @@index([uid, until])
}

model NextEngineSetting {
  id                  String    @id
  uid                 String    @unique
  minPricePct         Int       @default(93)
  autoUpdateEnabled   Boolean   @default(false)
  notificationEmail   String?
  consecutiveFailures Int       @default(0)
  lastFailureAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime
  isActive            Boolean   @default(true)

  @@index([uid, isActive])
}

model PriceUpdateLog {
  id              String        @id
  uid             String
  executionType   ExecutionType
  priceRatio      Float?
  minPricePct     Int
  totalProducts   Int           @default(0)
  updatedCount    Int           @default(0)
  failedCount     Int           @default(0)
  success         Boolean
  errorMessage    String?
  executedAt      DateTime      @default(now())
  details         String?
  metalType       MetalType?    @default(gold)
  executionTimeMs Int?

  @@index([uid, executedAt])
  @@index([uid, metalType, executedAt])
}

model SelectedProduct {
  id          String     @id
  uid         String
  goodsId     String
  selected    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  metalType   MetalType? @default(gold)
  errorCount  Int        @default(0)
  isLocked    Boolean    @default(false)
  lastSyncAt  DateTime?
  lockedUntil DateTime?
  syncStatus  SyncStatus @default(pending)

  @@unique([uid, goodsId])
  @@index([uid, isLocked])
  @@index([uid, metalType])
  @@index([uid, syncStatus])
}

model Session {
  id           String    @id
  uid          String    @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
}

model KeepAliveLog {
  id        Int      @id @default(autoincrement())
  status    String
  message   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("keepalive_logs")
}

model NextEngineToken {
  id           Int      @id @default(1)
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  clientId     String?  @map("client_id")
  clientSecret String?  @map("client_secret")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("nextengine_tokens")
}

model PriceHistory {
  id            Int      @id @default(autoincrement())
  date          DateTime @unique
  goldPrice     Float    @map("gold_price")
  platinumPrice Float?   @map("platinum_price")
  source        String   @default("tanaka")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("price_history")
}

model ExecutionLog {
  id               Int      @id @default(autoincrement())
  date             DateTime @unique
  status           String
  updatedProducts  Int      @default(0) @map("updated_products")
  goldRatio        Float?   @map("gold_ratio")
  platinumRatio    Float?   @map("platinum_ratio")
  executionReason  String   @map("execution_reason")
  errorMessage     String?  @map("error_message")
  skippedReason    String?  @map("skipped_reason")
  durationSeconds  Float?   @map("duration_seconds")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("execution_logs")
}

model PlatformSyncLog {
  id           Int      @id @default(autoincrement())
  syncedAt     DateTime @map("synced_at")
  productCount Int      @map("product_count")
  status       String
  details      String?
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("platform_sync_logs")
}

enum ExecutionType {
  cron
  manual
  webhook
}

enum MetalType {
  gold
  platinum
}

enum SyncStatus {
  pending
  syncing
  synced
  error
  skipped
}
